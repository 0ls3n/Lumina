# Maintainer: olsen <Rasmus782@gmail.com>

pkgname=lumina-pacman-git
pkgver=r8.da37a2d
pkgrel=1
pkgdesc="Transparent GTK4 package manager for Arch Linux"
arch=('any')
url="https://github.com/0ls3n/Lumina"
license=('MIT')
depends=(
  python
  python-gobject
  gtk4
  libadwaita
  pacman
  polkit
  hicolor-icon-theme
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
optdepends=(
  'paru: AUR helper'
  'yay: AUR helper'
  'polkit-gnome: graphical authentication agent'
)
provides=('lumina-pacman')
conflicts=('lumina-pacman')
source=("git+https://github.com/0ls3n/Lumina.git#branch=main")
sha256sums=('SKIP')

pkgver() {
  cd Lumina
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  git -C Lumina clean -dfx
}

build() {
  cd Lumina
  python -m build --wheel --no-isolation
}

check() {
  cd Lumina
  python -m unittest discover -s tests
}

package() {
  cd Lumina
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 data/com.github.lumina.desktop \
    "$pkgdir/usr/share/applications/com.github.lumina.desktop"
  install -Dm644 data/com.github.lumina.metainfo.xml \
    "$pkgdir/usr/share/metainfo/com.github.lumina.metainfo.xml"
  local size
  for size in 16x16 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
    install -Dm644 "lumina/icons/hicolor/${size}/apps/com.github.lumina.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}/apps/com.github.lumina.png"
  done
}
